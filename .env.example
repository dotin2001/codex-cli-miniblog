MYSQL_DATABASE=LOCAL_DATABASE_NAME
MYSQL_USER=LOCAL_MYSQL_USER
MYSQL_PASSWORD=LOCAL_MYSQL_PASSWORD
MYSQL_ROOT_PASSWORD=LOCAL_MYSQL_ROOT_PASSWORD
MYSQL_PORT=3307

# Host-machine development connects through the Docker Compose host port.
DATABASE_URL=mysql+pymysql://LOCAL_MYSQL_USER:LOCAL_MYSQL_PASSWORD@127.0.0.1:3307/LOCAL_DATABASE_NAME

# Docker-network/container usage connects to the Compose service name and container port.
# DATABASE_URL=mysql+pymysql://LOCAL_MYSQL_USER:LOCAL_MYSQL_PASSWORD@mysql:3306/LOCAL_DATABASE_NAME

MINIBLOG_ENV=development
JWT_SECRET_KEY=REPLACE_WITH_A_LONG_RANDOM_LOCAL_SECRET
JWT_ACCESS_TOKEN_EXPIRES_SECONDS=900
JWT_REFRESH_TOKEN_EXPIRES_SECONDS=604800
REFRESH_TOKEN_COOKIE_NAME=refreshToken
REFRESH_TOKEN_COOKIE_SECURE=false
REFRESH_TOKEN_COOKIE_SAMESITE=Lax
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
