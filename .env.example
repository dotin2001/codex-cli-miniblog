MYSQL_DATABASE=miniblog
MYSQL_USER=miniblog
MYSQL_PASSWORD=miniblog_password
MYSQL_ROOT_PASSWORD=root_password
MYSQL_PORT=3306

DATABASE_URL=mysql+pymysql://miniblog:miniblog_password@127.0.0.1:3306/miniblog

JWT_SECRET_KEY=replace-with-a-long-random-local-secret
JWT_ACCESS_TOKEN_EXPIRES_SECONDS=900
JWT_REFRESH_TOKEN_EXPIRES_SECONDS=604800
REFRESH_TOKEN_COOKIE_NAME=refreshToken
REFRESH_TOKEN_COOKIE_SECURE=false
REFRESH_TOKEN_COOKIE_SAMESITE=Lax
