MYSQL_DATABASE=miniblog
MYSQL_USER=miniblog
MYSQL_PASSWORD=miniblog_password
MYSQL_ROOT_PASSWORD=root_password
MYSQL_PORT=3307

# Host-machine development connects through the Docker Compose host port.
DATABASE_URL=mysql+pymysql://miniblog:miniblog_password@127.0.0.1:3307/miniblog

# Docker-network/container usage connects to the Compose service name and container port.
# DATABASE_URL=mysql+pymysql://miniblog:miniblog_password@mysql:3306/miniblog

MINIBLOG_ENV=development
JWT_SECRET_KEY=replace-with-a-long-random-local-secret
JWT_ACCESS_TOKEN_EXPIRES_SECONDS=900
JWT_REFRESH_TOKEN_EXPIRES_SECONDS=604800
REFRESH_TOKEN_COOKIE_NAME=refreshToken
REFRESH_TOKEN_COOKIE_SECURE=false
REFRESH_TOKEN_COOKIE_SAMESITE=Lax
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
